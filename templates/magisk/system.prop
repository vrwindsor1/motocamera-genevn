# Expose AUX (multi-camera) access for all cameras on Moto G Stylus 5G 2023 (genevn)
persist.vendor.camera.physical.num=3
persist.vendor.camera.expose.aux=1
persist.vendor.camera.privapp.list=com.motorola.camera3
vendor.camera.aux.packagelist=com.motorola.camera3,com.motorola.imagertuning_u,com.motorola.motcameradesktop,org.lineageos.aperture

# Motorola Camera Desktop & Google Lens OEM integration
ro.product.motcameradesktop=1
ro.com.google.lens.oem_camera_package=com.motorola.camera3
